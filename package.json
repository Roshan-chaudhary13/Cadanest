  "description": "3D Sheet Metal Unfolding and Nesting Desktop App",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "electron": "tsc -p tsconfig.electron.json && node -e \"fs.copyFileSync('src-electron/preload.cjs','dist-electron/preload.cjs')\" && electron .",
